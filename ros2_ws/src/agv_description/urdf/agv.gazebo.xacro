<?xml version="1.0"?>
<!-- Gazebo-only parts of the AGV, included by agv.urdf.xacro with sim:=true. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Contacts: rubber drive wheels; the caster wheels' friction turns their forks. -->
  <gazebo reference="left_wheel"><mu1>1</mu1><mu2>1</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1</mu1><mu2>1</mu2></gazebo>

  <!-- Caster springs (+/-5 mm, 2000 N/m, 2 mm preload) keep the drive wheels loaded with six wheels
       on a rigid body. Provisional values. -->
  <xacro:macro name="caster_contact" params="name">
    <gazebo reference="${name}_caster_wheel"><mu1>0.5</mu1><mu2>0.5</mu2></gazebo>
    <gazebo reference="${name}_caster_spring">
      <springReference>-0.002</springReference>
      <springStiffness>2000</springStiffness>
    </gazebo>
  </xacro:macro>
  <xacro:caster_contact name="front_left"/>
  <xacro:caster_contact name="front_right"/>
  <xacro:caster_contact name="rear_left"/>
  <xacro:caster_contact name="rear_right"/>

  <!-- Ultrasonic sensors: a 61-ray fan over the URM09's 60 deg cone; ultrasonic_sim turns the
       nearest return into sensor_msgs/Range. gpu_lidar sees visuals, hence the origins 6 mm outside. -->
  <xacro:macro name="ultrasonic" params="corner">
    <gazebo reference="ultrasonic_${corner}_link">
      <sensor name="ultrasonic_${corner}" type="gpu_lidar">
        <topic>/ultrasonic/${corner}/scan</topic>
        <gz_frame_id>ultrasonic_${corner}_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal><samples>61</samples><resolution>1</resolution>
              <min_angle>-0.523599</min_angle><max_angle>0.523599</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.02</min><max>5.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:ultrasonic corner="front_left"/>
  <xacro:ultrasonic corner="front_right"/>
  <xacro:ultrasonic corner="rear_left"/>
  <xacro:ultrasonic corner="rear_right"/>

  <!-- RPLidar A1M8 datasheet: 360 deg, 0.15-6 m, 5.5 Hz typical. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>5.5</update_rate>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
          <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>0.15</min><max>6.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <!-- Ground truth on a private topic; never replaces wheel odometry or /tf. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>100</update_frequency>
    </plugin>
    <!-- Drives the wheels from /cmd_vel like the ZLAC8015D. Its own odometry and TF stay inside
         Gazebo: wheel_odometry publishes odom -> base_link, as on the real robot. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_radius>${g['wheel_radius']}</wheel_radius><wheel_separation>${g['wheel_separation']}</wheel_separation>
      <topic>/cmd_vel</topic>
      <max_linear_velocity>0.5</max_linear_velocity><min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1</max_angular_velocity><min_angular_velocity>-1</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1</max_angular_acceleration><min_angular_acceleration>-1</min_angular_acceleration>
    </plugin>
    <!-- All joint angles: the wheels for wheel_odometry (like the driver's encoder counts), and the
         casters for robot_state_publisher. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
</robot>
