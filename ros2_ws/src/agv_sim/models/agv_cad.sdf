          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics><damping>20</damping><spring_reference>-0.002</spring_reference><spring_stiffness>2000</spring_stiffness></dynamics>
        </axis>
      </joint>
      <link name="rear_right_caster_swivel">
        <pose>-0.2950 -0.1750 0.0770 0 0 0</pose>
        <inertial><mass>0.09</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia></inertial>
        <visual name="caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES_4">
          <pose>0.0001 0.0004 -0.0167 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES_4.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="rear_right_caster_swivel_joint" type="revolute">
        <parent>rear_right_caster_mount</parent><child>rear_right_caster_swivel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
      </joint>
      <link name="rear_right_caster_wheel">
        <pose>-0.3179 -0.1746 0.0254 0 0 0</pose>
        <inertial><mass>0.37</mass><inertia><ixx>0.000072</ixx><iyy>0.000119</iyy><izz>0.000072</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.0254</radius></sphere></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="caster_2_inch_WHEEL_4">
          <pose>0.0000 0.0000 -0.0020 0.0000 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_4.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="rear_right_caster_wheel_joint" type="revolute">
        <parent>rear_right_caster_swivel</parent><child>rear_right_caster_wheel</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- Ground truth on a private topic; never replaces wheel odometry or /tf. -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>100</update_frequency>
      </plugin>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_radius>0.0655</wheel_radius><wheel_separation>0.3744</wheel_separation>
        <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_velocity>0.5</max_linear_velocity><min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>1</max_angular_velocity><min_angular_velocity>-1</min_angular_velocity>
        <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>1</max_angular_acceleration><min_angular_acceleration>-1</min_angular_acceleration>
      </plugin>
      <!-- Wheel angles for our own odometry, like the driver's encoder counts. -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
        <update_rate>50</update_rate>
      </plugin>
   </model>
</sdf>
