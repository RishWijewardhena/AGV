<?xml version="1.0" ?>
<sdf version="1.9">
   <model name="agv">
      <!-- AGV_Design_4 from Fusion (/home/rishmika/Documents/URDF4), for simulation.
           +X forward, +Y left. Model origin is the drive-axle floor projection; the CAD base_link
           (axle centre) is 0.073 m above it. Visual poses are the CAD URDF at zero joint angles.
           body.dae is base_link.dae decimated from 6.9 M to 0.23 M triangles (tools/decimate_dae.py).
           Physics uses simple shapes: a body box, sphere drive wheels and sprung sphere casters.
           Casters and linear rails are drawn fixed to the body; the CAD has them swivel and slide. -->
      <link name="base_link">
        <inertial>
          <pose>-0.0127 0.0002 0.1374 0 0 0</pose>
          <mass>56.0</mass>
          <inertia><ixx>1.1776</ixx><ixy>0.0064</ixy><ixz>0.0114</ixz><iyy>2.9333</iyy><iyz>-0.0022</iyz><izz>3.5799</izz></inertia>
        </inertial>
        <collision name="chassis_collision">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>0.70 0.46 0.29</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.073 1.5708 0 -1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/body.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_M12_STUD_BOLT_2">
          <pose>0.2949 -0.1746 0.0771 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_M12_STUD_BOLT_2.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_M12_STUD_BOLT">
          <pose>0.2951 0.1754 0.0718 -1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_M12_STUD_BOLT.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_M12_STUD_BOLT_3">
          <pose>-0.2949 0.1754 0.0718 -1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_M12_STUD_BOLT_3.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_M12_STUD_BOLT_4">
          <pose>-0.2949 -0.1746 0.0718 -1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_M12_STUD_BOLT_4.dae</uri></mesh></geometry>
        </visual>
        <visual name="rail_Component2_2">
          <pose>-0.1630 -0.1350 0.0900 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/rail_Component2_2.dae</uri></mesh></geometry>
        </visual>
        <visual name="rail_Component2">
          <pose>-0.1630 0.1350 0.0900 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/rail_Component2.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_UPPER_BASE_2_2">
          <pose>0.2949 -0.1746 0.0720 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_UPPER_BASE_2_2.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_UPPER_BASE_2">
          <pose>0.2951 0.1754 0.0718 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_UPPER_BASE_2.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_UPPER_BASE_2_3">
          <pose>-0.2956 0.1752 0.0718 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_UPPER_BASE_2_3.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_UPPER_BASE_2_4">
          <pose>-0.2949 -0.1746 0.0718 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_UPPER_BASE_2_4.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES_2">
          <pose>0.2949 -0.1746 0.0605 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES_2.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES">
          <pose>0.2951 0.1754 0.0603 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES_3">
          <pose>-0.2956 0.1752 0.0603 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES_3.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES_4">
          <pose>-0.2949 -0.1746 0.0603 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_BASE_SWIVEL_without_BRAKES_4.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_2">
          <pose>0.2719 -0.1746 0.0235 0.0000 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_2.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL">
          <pose>0.2721 0.1754 0.0234 1.5708 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_3">
          <pose>-0.3186 0.1752 0.0234 0.0000 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_3.dae</uri></mesh></geometry>
        </visual>
        <visual name="caster_2_inch_WHEEL_4">
          <pose>-0.3179 -0.1746 0.0234 0.0000 0.0000 1.5708</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/caster_2_inch_WHEEL_4.dae</uri></mesh></geometry>
        </visual>
        <!-- MTS160 itself is not in the CAD, only its bracket at x = 0.255-0.285 m.
             Placeholder 160 mm housing, bottom 20 mm above the floor (manual's recommendation). -->
        <visual name="mts160">
          <pose>0.27 0 0.035 0 0 0</pose>
          <geometry><box><size>0.025 0.16 0.03</size></box></geometry>
          <material><ambient>0.8 0.15 0.1 1</ambient><diffuse>0.8 0.15 0.1 1</diffuse></material>
        </visual>
        <!-- Ultrasonic sensors: the CAD A02YYUW faces are at x = +/-0.374 m, y = +/-0.18 m, 0.105 m up.
             gpu_lidar sees visuals, so each origin is 6 mm outside the robot. 60 deg cone like the URM09. -->
        <sensor name="ultrasonic_front_left" type="gpu_lidar">
          <pose>0.38 0.18 0.105 0 0 0</pose>
          <topic>/ultrasonic/front_left/scan</topic>
          <gz_frame_id>ultrasonic_front_left_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal><samples>61</samples><resolution>1</resolution>
                <min_angle>-0.523599</min_angle><max_angle>0.523599</max_angle></horizontal>
              <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
            </scan>
            <range><min>0.02</min><max>5.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
        <sensor name="ultrasonic_front_right" type="gpu_lidar">
          <pose>0.38 -0.18 0.105 0 0 0</pose>
          <topic>/ultrasonic/front_right/scan</topic>
          <gz_frame_id>ultrasonic_front_right_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal><samples>61</samples><resolution>1</resolution>
                <min_angle>-0.523599</min_angle><max_angle>0.523599</max_angle></horizontal>
              <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
            </scan>
            <range><min>0.02</min><max>5.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
        <sensor name="ultrasonic_rear_left" type="gpu_lidar">
          <pose>-0.38 0.18 0.105 0 0 3.14159</pose>
          <topic>/ultrasonic/rear_left/scan</topic>
          <gz_frame_id>ultrasonic_rear_left_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal><samples>61</samples><resolution>1</resolution>
                <min_angle>-0.523599</min_angle><max_angle>0.523599</max_angle></horizontal>
              <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
            </scan>
            <range><min>0.02</min><max>5.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
        <sensor name="ultrasonic_rear_right" type="gpu_lidar">
          <pose>-0.38 -0.18 0.105 0 0 3.14159</pose>
          <topic>/ultrasonic/rear_right/scan</topic>
          <gz_frame_id>ultrasonic_rear_right_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal><samples>61</samples><resolution>1</resolution>
                <min_angle>-0.523599</min_angle><max_angle>0.523599</max_angle></horizontal>
              <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
            </scan>
            <range><min>0.02</min><max>5.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
        <!-- RPLidar A1M8 (in the CAD body mesh): head centre x = 0.312 m, laser 0.317 m above the floor.
             Datasheet: 360 deg, 0.15-6 m, 5.5 Hz typical. -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.312 0 0.317 0 0 0</pose>
          <topic>/scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>5.5</update_rate>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal><samples>360</samples><resolution>1</resolution>
                <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
              <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
            </scan>
            <range><min>0.15</min><max>6.0</max><resolution>0.01</resolution></range>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
          </lidar>
        </sensor>
      </link>

      <!-- Drive wheels: 130 mm, centres 0.3744 m apart. Both axes +Y so forward is positive
           (the CAD URDF has the left axis reversed). -->
      <link name="left_wheel">
        <pose>0 0.1872 0.065 0 0 0</pose>
        <inertial>
          <mass>0.892</mass>
          <inertia><ixx>0.001003</ixx><iyy>0.001562</iyy><izz>0.001003</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.065</radius></sphere></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>0 0.0428 0 -3.1416 0 0</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/wheel_left.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <link name="right_wheel">
        <pose>0 -0.1872 0.065 0 0 0</pose>
        <inertial>
          <mass>0.892</mass>
          <inertia><ixx>0.001003</ixx><iyy>0.001562</iyy><izz>0.001003</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.065</radius></sphere></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>0 -0.0428 0 -3.1416 0 -3.1416</pose>
          <geometry><mesh><uri>model://agv_sim/meshes/cad/wheel_right.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- Casters: 2-inch wheels at the CAD wheel centres, as low-friction spheres on sprung mounts
           (+/-5 mm, 2000 N/m, 2 mm preload) so the drive wheels stay loaded. The CAD casters sit
           2 mm below the drive wheels; these springs absorb that. Provisional values. -->
      <link name="front_left_caster">
        <pose>0.272 0.175 0.0254 0 0 0</pose>
        <inertial><mass>0.37</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.0254</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
      </link>
      <joint name="front_left_caster_joint" type="prismatic">
        <parent>base_link</parent><child>front_left_caster</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics><damping>20</damping><spring_reference>-0.002</spring_reference><spring_stiffness>2000</spring_stiffness></dynamics>
        </axis>
      </joint>
      <link name="front_right_caster">
        <pose>0.272 -0.175 0.0254 0 0 0</pose>
        <inertial><mass>0.37</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.0254</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
      </link>
      <joint name="front_right_caster_joint" type="prismatic">
        <parent>base_link</parent><child>front_right_caster</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics><damping>20</damping><spring_reference>-0.002</spring_reference><spring_stiffness>2000</spring_stiffness></dynamics>
        </axis>
      </joint>
      <link name="rear_left_caster">
        <pose>-0.318 0.175 0.0254 0 0 0</pose>
        <inertial><mass>0.37</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.0254</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
      </link>
      <joint name="rear_left_caster_joint" type="prismatic">
        <parent>base_link</parent><child>rear_left_caster</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics><damping>20</damping><spring_reference>-0.002</spring_reference><spring_stiffness>2000</spring_stiffness></dynamics>
        </axis>
      </joint>
      <link name="rear_right_caster">
        <pose>-0.318 -0.175 0.0254 0 0 0</pose>
        <inertial><mass>0.37</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.0254</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
      </link>
      <joint name="rear_right_caster_joint" type="prismatic">
        <parent>base_link</parent><child>rear_right_caster</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics><damping>20</damping><spring_reference>-0.002</spring_reference><spring_stiffness>2000</spring_stiffness></dynamics>
        </axis>
      </joint>

      <!-- Ground truth on a private topic; never replaces wheel odometry or /tf. -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>100</update_frequency>
      </plugin>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_radius>0.065</wheel_radius><wheel_separation>0.3744</wheel_separation>
        <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_velocity>0.5</max_linear_velocity><min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>1</max_angular_velocity><min_angular_velocity>-1</min_angular_velocity>
        <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>1</max_angular_acceleration><min_angular_acceleration>-1</min_angular_acceleration>
      </plugin>
      <!-- Wheel angles for our own odometry, like the driver's encoder counts. -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
        <update_rate>50</update_rate>
      </plugin>
   </model>
</sdf>
