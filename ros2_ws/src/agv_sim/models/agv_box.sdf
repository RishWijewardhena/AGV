<?xml version="1.0" ?>
<sdf version="1.9">
   
   <model name="agv">
      <!-- +X forward, +Y left. Model origin is the drive-axle floor projection.
           Start 2 mm above the floor and settle under gravity.
           Overall envelope: 600 x 460 x 280 mm.
           Provisional: 20 kg body, 60 mm wheel width, 400 mm wheel-centre spacing.
           Body bottom/top: 80/280 mm; this is NOT 280 mm ground clearance. -->
   
      <link name="base_link">
        <inertial>
          <pose>0 0 0.18 0 0 0</pose>
          <mass>20</mass>
          <inertia><ixx>0.4193333333</ixx><iyy>0.6666666667</iyy><izz>0.9526666667</izz></inertia>
        </inertial>
        <collision name="chassis_collision">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>0.6 0.46 0.2</size></box></geometry>
        </collision>
        <visual name="chassis_visual">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>0.6 0.46 0.2</size></box></geometry>
          <material><ambient>0.1 0.35 0.7 1</ambient><diffuse>0.1 0.35 0.7 1</diffuse></material>
        </visual>

        <!-- Ultrasonic appearance only; sensing origins stay at X = +/-0.31 m. -->
        <visual name="ultrasonic_front_left_board">
          <pose>0.302 0.2 0.18 0 0 0</pose>
          <geometry><box><size>0.004 0.047 0.022</size></box></geometry>
          <material>
            <ambient>0.05 0.5 0.1 1</ambient>
            <diffuse>0.05 0.5 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="ultrasonic_front_left_transducer">
          <pose>0.307 0.2 0.18 0 1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <visual name="ultrasonic_front_right_board">
          <pose>0.302 -0.2 0.18 0 0 0</pose>
          <geometry><box><size>0.004 0.047 0.022</size></box></geometry>
          <material>
            <ambient>0.05 0.5 0.1 1</ambient>
            <diffuse>0.05 0.5 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="ultrasonic_front_right_transducer">
          <pose>0.307 -0.2 0.18 0 1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <visual name="ultrasonic_rear_left_board">
          <pose>-0.302 0.2 0.18 0 0 0</pose>
          <geometry><box><size>0.004 0.047 0.022</size></box></geometry>
          <material>
            <ambient>0.05 0.5 0.1 1</ambient>
            <diffuse>0.05 0.5 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="ultrasonic_rear_left_transducer">
          <pose>-0.307 0.2 0.18 0 -1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <visual name="ultrasonic_rear_right_board">
          <pose>-0.302 -0.2 0.18 0 0 0</pose>
          <geometry><box><size>0.004 0.047 0.022</size></box></geometry>
          <material>
            <ambient>0.05 0.5 0.1 1</ambient>
            <diffuse>0.05 0.5 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="ultrasonic_rear_right_transducer">
          <pose>-0.307 -0.2 0.18 0 -1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

      <!-- ultrasonic sensors front_left-->
      <sensor name="ultrasonic_front_left" type="gpu_lidar">
        <pose>0.31 0.20 0.18 0 0 0</pose>

        <topic>/ultrasonic/front_left/scan</topic>
        <gz_frame_id>ultrasonic_front_left_link</gz_frame_id>

        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>31</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.02</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>


      <!-- ultrasonic sensors front_right-->
      <sensor name="ultrasonic_front_right" type="gpu_lidar">
        <pose>0.31 -0.20 0.18 0 0 0</pose>

        <topic>/ultrasonic/front_right/scan</topic>
        <gz_frame_id>ultrasonic_front_right_link</gz_frame_id>

        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>31</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.02</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>

     <!-- rear left ultrasonic sensor  -->
      <sensor name="ultrasonic_rear_left" type="gpu_lidar">
        <pose>-0.31 0.20 0.18 0 0 3.14159</pose>

        <topic>/ultrasonic/rear_left/scan</topic>
        <gz_frame_id>ultrasonic_rear_left_link</gz_frame_id>

        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>31</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.02</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>

      <!-- rear right ultrasonic sensor  -->
      <sensor name="ultrasonic_rear_right" type="gpu_lidar">
        <pose>-0.31 -0.20 0.18 0 0 3.14159</pose>
        <topic>/ultrasonic/rear_right/scan</topic>
        <gz_frame_id>ultrasonic_rear_right_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>31</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.02</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>


      </link>
      <link name="left_wheel">
        <pose>0 0.2 0.0655 -1.5707963267948966 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.0013725625</ixx><iyy>0.0013725625</iyy><izz>0.002145125</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0655</radius><length>0.06</length></cylinder></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0655</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>





      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <link name="right_wheel">
        <pose>0 -0.2 0.0655 -1.5707963267948966 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.0013725625</ixx><iyy>0.0013725625</iyy><izz>0.002145125</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0655</radius><length>0.06</length></cylinder></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0655</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <!-- Caster approximation: low-friction spheres on compliant vertical mounts.
           +/-5 mm travel, 2000 N/m stiffness, 20 N s/m damping, 2 mm preload.
           Compliance keeps the centre drive wheels loaded over 1.3 mm tape.
           These are provisional simulation values, NOT measured caster suspension. -->
      <link name="front_left_caster">
        <pose>0.25 0.2 0.025 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="front_left_caster_joint" type="prismatic">
        <parent>base_link</parent><child>front_left_caster</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics>
            <damping>20</damping>
            <spring_reference>-0.002</spring_reference>
            <spring_stiffness>2000</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="front_right_caster">
        <pose>0.25 -0.2 0.025 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="front_right_caster_joint" type="prismatic">
        <parent>base_link</parent><child>front_right_caster</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics>
            <damping>20</damping>
            <spring_reference>-0.002</spring_reference>
            <spring_stiffness>2000</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="rear_left_caster">
        <pose>-0.25 0.2 0.025 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="rear_left_caster_joint" type="prismatic">
        <parent>base_link</parent><child>rear_left_caster</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics>
            <damping>20</damping>
            <spring_reference>-0.002</spring_reference>
            <spring_stiffness>2000</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="rear_right_caster">
        <pose>-0.25 -0.2 0.025 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="rear_right_caster_joint" type="prismatic">
        <parent>base_link</parent><child>rear_right_caster</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-0.005</lower><upper>0.005</upper></limit>
          <dynamics>
            <damping>20</damping>
            <spring_reference>-0.002</spring_reference>
            <spring_stiffness>2000</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <!-- Placeholder sensor housing: 160 mm across, bottom 28 mm above floor.
           X=250 mm is provisional. Virtual readings use the bottom face; no STEP mesh yet. -->
      <link name="mts160_link">
        <pose>0.25 0 0.043 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.0004416667</ixx><iyy>0.0000254167</iyy><izz>0.0004370833</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.025 0.16 0.03</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.16 0.03</size></box></geometry>
          <material><ambient>0.8 0.15 0.1 1</ambient><diffuse>0.8 0.15 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="sensor_mount" type="fixed"><parent>base_link</parent><child>mts160_link</child></joint>

      <!-- RPLidar A1M8 on the front of the top surface.
         Datasheet: 360°, 0.15–6 m, 5.5 Hz typical, ≤1° resolution, <1% distance error. -->
      <link name="lidar_link">
        <pose>0.22 0 0.3075 0 0 0</pose>
        <inertial>
          <mass>0.17</mass>
          <inertia><ixx>0.00009</ixx><iyy>0.00009</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.035</radius><length>0.055</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <topic>/scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>5.5</update_rate>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>6.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>
      <joint name="lidar_mount" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
      </joint>

      <!-- Ground truth on a private topic; never replaces wheel odometry or /tf. -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>100</update_frequency>
      </plugin>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_radius>0.0655</wheel_radius><wheel_separation>0.4</wheel_separation>
        <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_velocity>0.5</max_linear_velocity><min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>1</max_angular_velocity><min_angular_velocity>-1</min_angular_velocity>
        <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>1</max_angular_acceleration><min_angular_acceleration>-1</min_angular_acceleration>
      </plugin>
    </model>

</sdf>